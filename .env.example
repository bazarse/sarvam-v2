# PostgreSQL connection (Supabase to start, Oracle VM later — only this line changes)
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET="replace-with-64-char-random-hex"

# Cron endpoint protection — generate with: openssl rand -hex 32
CRON_SECRET="replace-with-random-string"

# Public app name shown in the UI
NEXT_PUBLIC_APP_NAME="Sarvam Device Manager"
